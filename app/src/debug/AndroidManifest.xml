<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only.

    A development server is a laptop on the same wifi speaking ws://, and
    Android blocks cleartext by default. Allowing it here rather than in the
    main manifest means the release build still refuses it, so shipping a
    plain-text connection to a real server is not something that can happen by
    forgetting to change something back.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
